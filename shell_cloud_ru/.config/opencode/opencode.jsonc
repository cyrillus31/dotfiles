{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "cloudru": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "cloud.ru",
      "options": {
        "baseURL": "https://foundation-models.api.cloud.ru/v1",
        "apiKey": "{env:CLOUD_RU_FOUNDATION_MODELS_API_KEY}"
      },
      "models": {
        /* GigaChat (cloud.ru first-party, internal) */
        "ai-sage/GigaChat3.5-432B-A28B":   { "name": "GigaChat 3.5 432B (internal) [code]" },
        "ai-sage/GigaChat3-10B-A1.8B":     { "name": "GigaChat 3 10B (internal) [code]" },
        "GigaChat/GigaChat-2-Max":         { "name": "GigaChat 2 Max (internal) [code]" },

        /* DeepSeek */
        "deepseek-ai/DeepSeek-V4-Pro":     { "name": "DeepSeek V4 Pro (internal) [code]" },
        "deepseek-ai/DeepSeek-V4-Flash":   { "name": "DeepSeek V4 Flash (internal) [code]" },
        "deepseek-ai/DeepSeek-V3.1-Terminus": { "name": "DeepSeek V3.1 Terminus (internal) [code]" },
        "deepseek-ai/DeepSeek-V3":         { "name": "DeepSeek V3 (internal) [code]" },
        "deepseek-ai/DeepSeek-R1-0528":    { "name": "DeepSeek R1 (internal) [code]" },
        "deepseek/deepseek-v3.2":          { "name": "DeepSeek V3.2 (internal) [code]" },
        "deepseek/deepseek-v3.2-speciale": { "name": "DeepSeek V3.2 Speciale (internal) [code]" },
        "deepseek/deepseek-chat-v3-0324":  { "name": "DeepSeek Chat v3 0324 (internal) [code]" },
        "deepseek/deepseek-r1-distill-llama-70b": { "name": "DeepSeek R1 Distill Llama 70B (internal) [code]" },

        /* Qwen */
        "Qwen/Qwen3.5-397B-A17B":          { "name": "Qwen3.5 397B (internal) [code]" },
        "Qwen/Qwen3.6-35B-A3B":            { "name": "Qwen3.6 35B (internal) [code]" },
        "qwen/qwen3-235b-a22b":            { "name": "Qwen3 235B (internal)" },
        "Qwen/Qwen3-Coder-Next":           { "name": "Qwen3 Coder (internal)" },
        "Qwen/Qwen3-30B-A3B":              { "name": "Qwen3 30B (internal)" },
        "Qwen/Qwen3-32B":                  { "name": "Qwen3 32B (internal)" },
        "qwen/qwen3-max-thinking":         { "name": "Qwen3 Max Thinking (internal)" },

        /* Kimi/Moonshot */
        "moonshotai/Kimi-K2.6":            { "name": "Kimi K2.6 (internal)" },
        "moonshotai/kimi-k2.5":            { "name": "Kimi K2.5 (internal)" },
        "moonshotai/kimi-k2-0905":         { "name": "Kimi K2 0905 (internal)" },

        /* GLM/Zhipu */
        "zai-org/GLM-5.2":                 { "name": "GLM 5.2 (internal)" },
        "zai-org/GLM-5.1":                 { "name": "GLM 5.1 (internal)" },
        "zai-org/GLM-4.7":                 { "name": "GLM 4.7 (internal)" },
        "z-ai/glm-5":                      { "name": "GLM 5 (internal)" },
        "z-ai/glm-4.6":                    { "name": "GLM 4.6 (internal)" },
        "z-ai/glm-4.6v":                   { "name": "GLM 4.6V (internal)" },
        "z-ai/glm-4.5-air":                { "name": "GLM 4.5 Air (internal)" },

        /* MiniMax */
        "MiniMaxAI/MiniMax-M3":            { "name": "MiniMax M3 (internal)" },
        "MiniMaxAI/MiniMax-M2.5":          { "name": "MiniMax M2.5 (internal)" },

        /* Meta */
        "meta-llama/llama-3.3-70b-instruct": { "name": "Llama 3.3 70B (internal)" },

        /* Xiaomi/MiMo */
        "xiaomi/mimo-v2.5-pro":            { "name": "MiMo V2.5 Pro (internal)" }
      }
    }
  }
}